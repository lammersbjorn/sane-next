#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

git diff --cached --check

python3 - <<'PY'
from pathlib import Path
import tomllib

tomllib.loads(Path("TRACK.toml").read_text(encoding="utf-8"))
PY

for required in \
  "AGENTS.md" \
  ".github/copilot-instructions.md" \
  "docs/adr/0002-use-track-toml-plus-adrs-for-tracking.md" \
  "docs/adr/0004-use-pi-overlay-with-codex-skill-export.md"; do
  if [ ! -f "$required" ]; then
    echo "Missing required repo file: $required" >&2
    exit 1
  fi
done

for forbidden in \
  "docs/adr/0001-use-github-issues-plus-adrs-for-tracking.md" \
  "docs/adr/0003-start-with-a-small-coordinator-not-a-framework.md"; do
  if [ -e "$forbidden" ]; then
    echo "Superseded ADR file must not exist: $forbidden" >&2
    exit 1
  fi
done
