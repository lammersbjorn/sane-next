#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

git diff --cached --check

python3 - <<'PY'
from pathlib import Path
import tomllib

data = tomllib.loads(Path("TRACK.toml").read_text(encoding="utf-8"))

required_top = {"version", "updated", "phase", "goal", "next_focus", "tracking", "current", "work_items"}
missing_top = sorted(required_top - data.keys())
if missing_top:
    raise SystemExit(f"TRACK.toml missing required top-level keys: {', '.join(missing_top)}")

for forbidden in ("items", "hypotheses"):
    if forbidden in data:
        raise SystemExit(f"TRACK.toml must not contain legacy section: {forbidden}")

tracking = data["tracking"]
for key in ("schema", "canonical_current_state", "canonical_foundation", "canonical_steps", "progress_evidence", "rules"):
    if key not in tracking:
        raise SystemExit(f"TRACK.toml missing tracking.{key}")

current = data["current"]
for key in ("summary", "exit_criteria", "refs"):
    if key not in current:
        raise SystemExit(f"TRACK.toml missing current.{key}")

items = data["work_items"]
if not isinstance(items, list) or not items:
    raise SystemExit("TRACK.toml must contain at least one [[work_items]] entry")
if len(items) > 2:
    raise SystemExit("TRACK.toml must keep at most 2 active-window work items")

allowed_statuses = {"ready", "in_progress", "blocked", "queued"}
in_progress_count = 0
for item in items:
    for key in ("id", "status", "title", "why_now", "write_scope", "inputs", "done_when"):
        if key not in item:
            raise SystemExit(f"TRACK.toml work item missing {key}")
    if item["status"] not in allowed_statuses:
        raise SystemExit(f"TRACK.toml work item has invalid status: {item['status']}")
    if item["status"] == "in_progress":
        in_progress_count += 1
    for key in ("write_scope", "inputs", "done_when"):
        value = item[key]
        if not isinstance(value, list) or not value:
            raise SystemExit(f"TRACK.toml work item field {key} must be a non-empty list")

if in_progress_count > 1:
    raise SystemExit("TRACK.toml may contain at most one in_progress work item")

allowed_markdown = {
    "README.md",
    "AGENTS.md",
    "CONTRIBUTING.md",
    ".github/copilot-instructions.md",
    "docs/FOUNDATION.md",
    "docs/IMPLEMENTATION.md",
}

actual_markdown = {
    str(path).replace("\\", "/")
    for path in Path(".").rglob("*.md")
    if ".git/" not in str(path).replace("\\", "/")
}

unexpected = sorted(actual_markdown - allowed_markdown)
if unexpected:
    raise SystemExit(
        "Unexpected markdown files found outside the fixed repo structure: "
        + ", ".join(unexpected)
    )
PY

for required in \
  "AGENTS.md" \
  ".github/copilot-instructions.md" \
  "docs/FOUNDATION.md" \
  "docs/IMPLEMENTATION.md"; do
  if [ ! -f "$required" ]; then
    echo "Missing required repo file: $required" >&2
    exit 1
  fi
done
